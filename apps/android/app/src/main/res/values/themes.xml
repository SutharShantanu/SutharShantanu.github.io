<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Portfolio" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/portfolio_launch_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- SplashScreen API: modern splash logo on window background -->
    <style name="PortfolioLaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/portfolio_launch_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Portfolio</item>
    </style>
</resources>
