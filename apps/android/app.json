{
  "expo": {
    "name": "Shantanu Suthar",
    "slug": "shantanu-portfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shantanu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.shantanusuthar.portfolio"
    },
    "android": {
      "package": "dev.shantanusuthar.portfolio",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B0C0E"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0B0C0E",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0B0C0E"
          }
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Portfolio of Shantanu Suthar, Software Engineer: work, experience, skills and contact.",
    "backgroundColor": "#F6F1EC"
  }
}
